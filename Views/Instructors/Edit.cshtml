@model InstructorInfoSystem.Models.Instructor

@{
    ViewData["Title"] = "Edit Instructor";
}

<div class="container" style="max-width: 760px;">
    <div class="card overflow-hidden">
        <div class="form-card-header">
            <h4 class="mb-0 fw-bold"><i class="bi bi-pencil-square me-2"></i>Edit Instructor</h4>
        </div>

        <div class="card-body p-4">
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="InstructorId" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" role="alert"></div>

                <partial name="_InstructorFields" model="Model" />

                <button type="submit" class="btn btn-solid-edit">
                    <i class="bi bi-check-lg"></i> Save Changes
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary ms-2">Cancel</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
