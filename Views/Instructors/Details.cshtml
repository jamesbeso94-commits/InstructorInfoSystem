@model InstructorInfoSystem.Models.Instructor

@{
    ViewData["Title"] = "Instructor Details";
}

<div class="container" style="max-width: 760px;">
    <div class="card overflow-hidden">
        <div class="form-card-header">
            <h4 class="mb-1 fw-bold">@Model.FullName</h4>
            <span class="id-chip">@Model.Designation &middot; Instructor #@Model.InstructorId</span>
        </div>

        <div class="card-body p-4">
            <div class="detail-row">
                <span class="label">Instructor ID</span>
                <span class="value">@Model.InstructorId</span>
            </div>
            <div class="detail-row">
                <span class="label">Full Name</span>
                <span class="value">@Model.FullName</span>
            </div>
            <div class="detail-row">
                <span class="label">Age</span>
                <span class="value">@Model.Age</span>
            </div>
            <div class="detail-row">
                <span class="label">Gender</span>
                <span class="value">@Model.Gender</span>
            </div>
            <div class="detail-row">
                <span class="label">Contact Number</span>
                <span class="value">@Model.ContactNumber</span>
            </div>
            <div class="detail-row">
                <span class="label">Address</span>
                <span class="value">@Model.Address</span>
            </div>
            <div class="detail-row">
                <span class="label">Designation</span>
                <span class="value">@Model.Designation</span>
            </div>
            <div class="detail-row">
                <span class="label">Majorship</span>
                <span class="value">@Model.Majorship</span>
            </div>
            <div class="detail-row">
                <span class="label">Bachelor Degree</span>
                <span class="value">@Model.BachelorDegree</span>
            </div>
            <div class="detail-row">
                <span class="label">E-mail Address</span>
                <span class="value">@Model.Email</span>
            </div>

            <div class="d-flex flex-wrap gap-2 mt-4">
                <a asp-action="Edit" asp-route-id="@Model.InstructorId" class="btn btn-solid-edit">
                    <i class="bi bi-pencil-square"></i> Edit Instructor
                </a>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Back to List
                </a>
            </div>
        </div>
    </div>
</div>
