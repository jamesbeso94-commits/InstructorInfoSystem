@{
    ViewData["Title"] = "Dashboard";
    var totalInstructors = (int)ViewBag.TotalInstructors;
    var firstName = User.FindFirst("FirstName")?.Value;
    var lastName = User.FindFirst("LastName")?.Value;
}

<div class="container-fluid px-4 px-md-5">

    <!-- Welcome Section -->
    <div class="dashboard-hero mb-4">
        <p class="text-uppercase fw-semibold text-muted mb-2" style="letter-spacing:1px;font-size:12px;">
            <i class="bi bi-stars"></i> Dashboard
        </p>
        <h1 class="display-6 mb-2">Welcome back, @firstName!</h1>
        <p class="fs-5 mb-4">Manage instructor information easily in one place.</p>

        <a asp-controller="Instructors" asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Add Instructor
        </a>
    </div>

    <!-- Dashboard Summary -->
    <div class="row g-4 mb-4">

        <div class="col-12 col-md-6 col-lg-4">
            <div class="dashboard-card accent-indigo h-100">
                <div class="p-4 d-flex flex-column h-100">
                    <h6 class="text-muted text-uppercase fw-semibold mb-2" style="letter-spacing:.6px;">
                        Total Instructors
                    </h6>
                    <div class="stat-number mb-2">@totalInstructors</div>
                    <p class="text-muted">Instructor records saved in your database.</p>

                    <a asp-controller="Instructors"
                       asp-action="Index"
                       class="btn btn-primary mt-auto align-self-start">
                        View Instructors <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-lg-4">
            <div class="dashboard-card accent-green h-100">
                <div class="p-4 d-flex flex-column h-100">
                    <h5 class="fw-bold">Add an Instructor</h5>
                    <p class="text-muted">
                        Register a new instructor and save their information in the database.
                    </p>

                    <a asp-controller="Instructors"
                       asp-action="Create"
                       class="btn btn-success mt-auto align-self-start">
                        <i class="bi bi-plus-lg"></i> Add Instructor
                    </a>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-lg-4">
            <div class="dashboard-card accent-sky h-100">
                <div class="p-4 d-flex flex-column h-100">
                    <h5 class="fw-bold">Manage Records</h5>
                    <p class="text-muted">
                        Search, sort, view, edit, or delete existing instructor records.
                    </p>

                    <a asp-controller="Instructors"
                       asp-action="Index"
                       class="btn btn-outline-primary mt-auto align-self-start">
                        Manage Instructors <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>

    </div>

    <!-- Account Summary Section -->
    <div class="dashboard-card accent-amber">
        <div class="p-4">
            <div class="d-flex align-items-center gap-3 mb-4">
                <div>
                    <h4 class="mb-0 fw-bold">Your Account</h4>
                    <small class="text-muted">Signed-in user details</small>
                </div>
            </div>

            <div class="row g-3">
                <div class="col-12 col-md-6">
                    <div class="info-box">
                        <span class="text-muted d-block small text-uppercase fw-semibold">Full Name</span>
                        <strong>@firstName @lastName</strong>
                    </div>
                </div>

                <div class="col-12 col-md-6">
                    <div class="info-box">
                        <span class="text-muted d-block small text-uppercase fw-semibold">Email Address</span>
                        <strong>@User.Identity?.Name</strong>
                    </div>
                </div>
            </div>

            <div class="mt-4">
                <a asp-controller="Account"
                   asp-action="Profile"
                   class="btn btn-outline-primary">
                    <i class="bi bi-person-circle"></i> View My Profile
                </a>
            </div>
        </div>
    </div>

</div>
